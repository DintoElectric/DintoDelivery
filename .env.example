# Copy to .env for local `netlify dev`. Set the same values in
# Netlify → Site settings → Environment variables for the deployed site.

# Comma-separated usernames allowed to hold the "Shop manager" (prefab
# manager) role. Its length is the hard cap on how many manager accounts can
# exist — for two managers, list exactly two usernames.
ADMIN_USERNAMES=john,harry

# Long random string used to sign session tokens. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string
